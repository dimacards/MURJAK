generator client {
  provider = "prisma-client-js"
}

datasource db {
  // URL и driver adapter настраиваются в prisma.config.ts (Prisma 7+).
  // DATABASE_URL = DIRECT_URL — оба указывают на Supabase session pooler 5432.
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// Тип фотографии товара:
//  - MODEL: одежда на человеке (фото с моделью)
//  - ITEM:  сама вещь без человека
// На сайте фильтруется toggle'ом: «на модели» / «вещь».
enum PhotoKind {
  MODEL
  ITEM
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Product {
  id        Int      @id @default(autoincrement())
  name      String   // название товара, например «Cardigan Jenasis»
  price     Int      // целое число рублей
  inStock   Boolean  @default(true) // если false — на сайте показываем плашку «нет в наличии», но не скрываем

  // Видео вещи (опциональное, одно). Грузится через бота в Supabase Storage.
  // Telegram-боты могут скачивать файлы до 20 МБ — лимит проверяется при приёме.
  videoStoragePath    String?
  videoPublicUrl      String?
  videoTelegramFileId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos   Photo[]
  features Feature[]
}

model Photo {
  id             Int       @id @default(autoincrement())
  productId      Int
  storagePath    String    // путь в Supabase Storage (например: products/42/0.jpg)
  publicUrl      String    // публичная ссылка для отображения на сайте и в боте
  telegramFileId String?   // file_id фото в Telegram (для быстрых пре-просмотров в боте без скачивания)
  order          Int       // порядок отображения (0 = первое/главное фото)
  kind           PhotoKind @default(ITEM) // на модели или сама вещь
  createdAt      DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Feature {
  // «Особенность» товара — короткая строка, показывается ТОЛЬКО на открытой
  // карточке товара, не в сетке. Работник вводит в боте по одной.
  id        Int    @id @default(autoincrement())
  productId Int
  text      String
  order     Int    // порядок ввода (0, 1, 2, …) — порядок не меняется после ввода

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model BotSession {
  // Хранит состояние пошаговых диалогов @grammyjs/conversations между
  // webhook-вызовами (in-memory не работает в serverless: каждый хит = свежий процесс).
  // key — ctx.chatId (string), value — JSON-сериализованный VersionedState<ConversationData>.
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
