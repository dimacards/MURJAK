# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен бота из @BotFather
BOT_TOKEN=

# Telegram ID владельца магазина (получить можно у @userinfobot)
OWNER_TELEGRAM_ID=

# ID канала. Можно username без @ (например: my_vintage_shop_channel)
# или числовой chat_id (для приватных каналов, например: -1001234567890).
# Бот должен быть админом канала с правом постинга.
CHANNEL_ID=

# ID служебного чата работников (групповой чат, куда бот шлёт копии товаров
# с кнопками «Редактировать» / «Нет в наличии»). Бот должен быть админом чата.
# Это число (для супергрупп обычно отрицательное, например: -1001234567890).
# Как получить: добавь бота в чат, напиши там любое сообщение, открой
# https://api.telegram.org/bot<TOKEN>/getUpdates — увидишь chat.id.
SERVICE_CHAT_ID=

# ─── База данных (Supabase Postgres) ─────────────────────────────────────────
# Connection string с пулингом (Transaction mode, порт 6543) — для Prisma в рантайме
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (порт 5432, БЕЗ pgbouncer) — для миграций Prisma
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project URL из Settings → API
SUPABASE_URL=https://[project-ref].supabase.co

# service_role ключ (НЕ anon, НЕ publishable) — из Settings → API → Project API keys.
# Нужен для загрузки фото в Storage в обход RLS.
SUPABASE_SERVICE_KEY=

# Название bucket для фото товаров (создать вручную в Supabase Storage)
SUPABASE_BUCKET=product-photos

# ─── Сайт ─────────────────────────────────────────────────────────────────────
# Публичный URL деплоя (для формирования ссылок на товары в канале)
# Локально: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
