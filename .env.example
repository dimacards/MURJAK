# Сайт полностью статический (output: export) — БД, бота и Supabase больше нет,
# секретов тоже нет. Единственная опциональная переменная:

# Публичный URL сайта — нужен только для абсолютных ссылок в OG-тегах
# (превью при шаринге ссылок на товары). При сборке под прод укажи домен.
# Пример: https://murjak.ru
NEXT_PUBLIC_SITE_URL=http://localhost:3000
