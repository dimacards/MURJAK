# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен бота из @BotFather
BOT_TOKEN=

# Telegram ID работника-владельца магазина (получить можно у @userinfobot).
# Бот игнорирует всех, кроме этого ID.
WORKER_TELEGRAM_ID=

# ─── База данных (Supabase Postgres) ─────────────────────────────────────────
# Session pooler (порт 5432) — для Prisma в рантайме И для миграций.
# ❌ НЕ использовать Transaction pooler (6543) с @prisma/adapter-pg —
# pg-клиент держит persistent connection и prepared statements,
# а transaction pooler рассчитан на короткоживущие коннекты без state.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# Project URL из Settings → API (без /rest/v1/)
SUPABASE_URL=https://[project-ref].supabase.co

# service_role ключ из Settings → API → Project API keys → service_role.
# Нужен для загрузки фото в Storage в обход RLS. НЕ anon, НЕ publishable.
SUPABASE_SERVICE_KEY=

# Название public bucket для фото товаров (создать вручную в Storage)
SUPABASE_BUCKET=products

# ─── Сайт ─────────────────────────────────────────────────────────────────────
# Публичный URL деплоя (для OG-тегов при шаринге ссылок на товары).
# Локально: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
